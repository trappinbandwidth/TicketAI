# Local development example only. Do not commit real secrets.
ANTHROPIC_API_KEY=sk-ant-...
PROMPT_VERSION=v2
USE_MOCK=true

# Local development fallback only. Production must set a strong secret value.
API_KEY=cdl-local-dev

# Firebase Admin SDK
# Prefer Application Default Credentials when possible.
#
# Option A: paste the full service account JSON as one line for local dev only.
# Never commit real service account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option B: set project ID and use Application Default Credentials (GCE / Cloud Run)
FIREBASE_PROJECT_ID=

# Driver verification vault. Inject both from Secret Manager in production.
# Key must be a base64-encoded 32-byte AES key; never commit a real value.
PII_ENCRYPTION_KEY_B64=
PII_ENCRYPTION_KEY_ID=

# TIP OS WP-01 dark-launch flag. Keep false until canonical identity backfill
# and negative authorization checks pass for the rollout cohort.
TIP_OS_IDENTITY_ENABLED=false
# Additional two-part guard for the migration script's --apply mode.
TIP_OS_BACKFILL_APPLY_ENABLED=false
# Records legacy-vs-platform authorization decisions but never enforces them.
TIP_OS_AUTH_SHADOW_ENABLED=false
